{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter=twikoo-vercel run build",
  "outputDirectory": "packages/server-vercel/dist",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm --filter=twikoo-vercel run dev",
  "functions": {
    "packages/server-vercel/dist/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "packages/server-vercel/dist/index.js"
    }
  ]
}